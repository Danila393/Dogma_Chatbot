APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=sqlite+aiosqlite:///./data/apartments.db

# Any OpenAI-compatible provider. Examples:
#   OpenAI:      LLM_BASE_URL=            LLM_MODEL=gpt-4o-mini
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=openai/gpt-4o-mini
#   DeepSeek:    LLM_BASE_URL=https://api.deepseek.com        LLM_MODEL=deepseek-chat
#   Ollama:      LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

PARSER_TIMEOUT=30
PARSER_CONCURRENCY=3
PARSER_MAX_RETRIES=3
PARSER_REQUEST_DELAY=0.3
PARSER_PAGE_SIZE=100
PARSER_CITY_IDS=1,2,3,4,5,6,7

DEFAULT_SEARCH_LIMIT=5

# Telegram bot (optional, `docker compose --profile bot up`)
TELEGRAM_BOT_TOKEN=
BOT_API_BASE_URL=http://api:8000
